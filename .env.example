# Root env — used by docker-compose.yml. Backend and frontend have their
# own .env.example files with the full variable lists.
DB_DATABASE=cloud_cost_tracker
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_PORT=5432

# Backend
APP_URL=http://localhost:8000
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
