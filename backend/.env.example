APP_NAME="Cloud Cost Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cloud_cost_tracker
DB_USERNAME=postgres
DB_PASSWORD=

# File storage for uploaded CSVs: "local" by default.
# Set FILESYSTEM_DISK=s3 (and the AWS_* vars below) to store uploads in S3.
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Cost-increase detection: flag a service when its latest month is up by
# more than this % vs the previous month (or it rose 2 months in a row).
COST_INCREASE_THRESHOLD_PERCENT=20

# Budget alert thresholds (fractions of the budget amount).
BUDGET_WARNING_THRESHOLD=0.80
BUDGET_EXCEEDED_THRESHOLD=1.00

# Max upload size is enforced in app/Services/CsvParser.php (10 MB).
